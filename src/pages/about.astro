---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { personSchema } from '../utils/structured-data';
---

<BaseLayout
  title="About"
  description="About Asifur Rahman — engineering interests, background, and this site."
  jsonLd={personSchema()}
>
  <Container as="section" variant="prose" class="page">
    <h1>About</h1>
    <p>
      {/* TODO: replace with a real bio. Do not invent achievements, degrees,
          employment, or credentials — leave as placeholder until provided. */}
      I’m Asifur Rahman, an engineering student and developer. This site
      collects my projects, technical writing, and learning notes.
    </p>
  </Container>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .page p {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }
</style>
