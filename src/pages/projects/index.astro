---
/**
 * Projects listing (Phase 3).
 * Reads the `projects` content collection and renders a card grid.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getAllProjects, toSummary } from '../../utils/projects';

const projects = (await getAllProjects()).map(toSummary);
---

<BaseLayout title="Projects" description="Engineering projects by Asifur Rahman.">
  <Container as="section" class="page">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="intro">
        A selection of things I’ve built and am building. Each project has its
        own page with more detail.
      </p>
    </header>

    {
      projects.length > 0 ? (
        <div class="grid">
          {projects.map((project) => (
            <ProjectCard project={project} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="empty">No projects yet — check back soon.</p>
      )
    }
  </Container>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .page-head {
    margin-bottom: var(--space-8);
  }
  .intro {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    max-width: var(--container-prose);
  }
  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
