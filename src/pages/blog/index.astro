---
/**
 * Blog listing (Phase 4).
 * Renders all published posts (newest first) as BlogCards. Drafts are excluded
 * in production by getPublishedPosts().
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPublishedPosts, toSummary } from '../../utils/blog';

const posts = (await getPublishedPosts()).map(toSummary);
---

<BaseLayout title="Blog" description="Technical writing and notes by Asifur Rahaman.">
  <Container as="section" variant="prose" class="page">
    <header class="page-head">
      <h1>Blog</h1>
      <p class="intro">
        Notes, explanations, and write-ups on things I’m learning and building.
      </p>
    </header>

    {
      posts.length > 0 ? (
        <div class="list">
          {posts.map((post) => (
            <BlogCard post={post} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <p class="empty">No posts yet — check back soon.</p>
      )
    }
  </Container>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12);
  }
  .page-head {
    margin-bottom: var(--space-8);
  }
  .intro {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .empty {
    color: var(--color-text-muted);
  }
</style>
