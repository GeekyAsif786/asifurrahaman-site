---
/**
 * BlogPostLayout — the article shell for a single blog post (spec §19).
 *
 * Owns everything around the article body: SEO metadata (via BaseLayout),
 * breadcrumbs, the article header (title/description/dates/tags/reading time),
 * and the prev/next + related-posts footer.
 *
 * The rendered MDX/Markdown body is passed in through the default <slot />.
 * The page (`/blog/[slug]`) stays thin: it queries data, runs render(), and
 * hands the pieces to this layout.
 */
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Tag from '../components/Tag.astro';
import { formatDate, formatLongDate, isoDate, readingTimeLabel } from '../utils/format';
import type { PostEntry } from '../utils/blog';
import { blogPostingSchema, breadcrumbSchema } from '../utils/structured-data';

interface Props {
  post: PostEntry;
  readingTime: number;
  prev: PostEntry | null;
  next: PostEntry | null;
  related: PostEntry[];
}

const { post, readingTime, prev, next, related } =
  Astro.props as Props;
const d = post.data;

// ---- Structured data (built from real frontmatter only) ----
const postUrl = `/blog/${post.id}/`;
const publishedISO = d.pubDate.toISOString();
const modifiedISO = d.updatedDate ? d.updatedDate.toISOString() : undefined;

const articleJsonLd = blogPostingSchema({
  title: d.title,
  description: d.description,
  url: postUrl,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  tags: d.tags,
  image: d.heroImage,
});

const breadcrumbJsonLd = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: d.title }, // current page → no url
]);
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={d.heroImage}
  ogType="article"
  publishedTime={publishedISO}
  modifiedTime={modifiedISO}
  jsonLd={[articleJsonLd, breadcrumbJsonLd]}
>
  <Container as="article" variant="prose" class="post">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog' },
        { label: d.title },
      ]}
    />

    <header class="post-head">
      <h1>{d.title}</h1>
      <p class="published-date">
        <time datetime={isoDate(d.pubDate)}>{formatLongDate(d.pubDate)}</time>
      </p>
      <p class="desc">{d.description}</p>
      <div class="meta">
        {
          d.updatedDate && (
            <span>Updated <time datetime={isoDate(d.updatedDate)}>{formatDate(d.updatedDate)}</time></span>
          )
        }
        <span>{readingTimeLabel(readingTime)}</span>
      </div>
      {
        d.tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {d.tags.map((t) => (
              <li>
                <Tag tag={t} />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      d.heroImage && (
        <img
          class="hero"
          src={d.heroImage}
          alt={d.heroImageAlt ?? ''}
          loading="eager"
        />
      )
    }

    <div class="prose">
      <slot />
    </div>

    {/* Related posts (by shared tags). */}
    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-h">
          <h2 id="related-h">Related posts</h2>
          <ul>
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id}`}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* Previous / next navigation. */}
    {
      (prev || next) && (
        <nav class="pager" aria-label="Post navigation">
          <div class="pager-cell">
            {prev && (
              <a href={`/blog/${prev.id}`} rel="prev">
                <span class="pager-label">← Newer</span>
                <span class="pager-title">{prev.data.title}</span>
              </a>
            )}
          </div>
          <div class="pager-cell pager-cell--right">
            {next && (
              <a href={`/blog/${next.id}`} rel="next">
                <span class="pager-label">Older →</span>
                <span class="pager-title">{next.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </Container>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-8) var(--space-16);
  }
  .post-head {
    margin-block: var(--space-6) var(--space-8);
  }
  .desc {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-body-alt);
    font-size: var(--text-lg);
  }
  .published-date {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .hero {
    margin-block: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    width: 100%;
  }

  /* The TOC sits between header and body on all viewports; subtle glass box. */
  .post :global(.toc) {
    margin-block: var(--space-8);
    padding: var(--space-4) var(--space-6);
    border: var(--border-width) solid var(--glass-border-line);
    border-radius: var(--radius);
    background: var(--glass-bg);
  }

  /* ---- Article body typography ----
     A clean, publication-style reading surface. No glassmorphism here — the
     text is the priority. Comfortable measure via the prose container width. */
  .prose {
    font-size: 1.075rem;
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin-top: var(--space-16);
    margin-bottom: var(--space-4);
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    margin-top: var(--space-12);
    margin-bottom: var(--space-2);
    font-size: 1.28rem;
    scroll-margin-top: 5rem;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin-top: var(--space-5, 1.25rem);
  }
  .prose :global(p) {
    margin-top: var(--space-4);
    font-family: var(--font-body-alt);
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin-top: var(--space-4);
    padding-left: var(--space-6);
  }
  .prose :global(li + li) {
    margin-top: var(--space-2);
  }
  .prose :global(li)::marker {
    color: var(--color-text-muted);
  }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-accent) 40%, transparent);
    text-underline-offset: 3px;
  }
  .prose :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding: var(--space-1) var(--space-5);
    background: var(--color-accent-soft);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-text);
    font-style: normal;
  }
  .prose :global(blockquote p) {
    color: var(--color-text-muted);
  }

  /* Code blocks: comfortable padding, subtle rounded border, mono font.
     The copy button (injected by script) sits top-right. */
  .prose :global(.code-block) {
    position: relative;
    margin-top: var(--space-6);
  }
  .prose :global(pre) {
    margin: 0;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    border: var(--border-width) solid var(--color-border);
    overflow-x: auto;
  }
  .prose :global(.copy-btn) {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.55rem;
    font: inherit;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    background: var(--glass-bg-strong);
    border: var(--border-width) solid var(--glass-border-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  @supports (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px)) {
    .prose :global(.copy-btn) {
      -webkit-backdrop-filter: blur(var(--glass-blur));
      backdrop-filter: blur(var(--glass-blur));
    }
  }
  .prose :global(.code-block:hover .copy-btn),
  .prose :global(.copy-btn:focus-visible) {
    opacity: 1;
  }
  .prose :global(.copy-btn:hover) {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .prose :global(.copy-btn[data-copied='true']) {
    color: var(--color-accent);
    opacity: 1;
  }

  /* Tables become their own horizontal scroll container so wide tables never
     overflow the viewport on small screens. */
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin-top: var(--space-6);
    font-size: var(--text-base);
  }
  .prose :global(th),
  .prose :global(td) {
    border: var(--border-width) solid var(--color-border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }
  .prose :global(th) {
    background: var(--color-bg-subtle);
    font-weight: 650;
  }
  .prose :global(img) {
    border-radius: var(--radius);
  }

  /* ---- Related ---- */
  .related {
    margin-top: var(--space-16);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }
  .related ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* ---- Pager ---- */
  .pager {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }
  @media (min-width: 480px) {
    .pager {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }
  @media (min-width: 480px) {
    .pager-cell--right {
      text-align: right;
    }
  }
  .pager a {
    display: inline-flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
  }
  .pager-label {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }
  .pager-title {
    color: var(--color-text);
  }
  .pager a:hover .pager-title {
    color: var(--color-accent);
  }
</style>

<script>
  /*
    Progressive enhancement: add a "Copy" button to each code block.
    - No dependency (uses the Clipboard API with a fallback).
    - Runs only on article pages (this layout).
    - If JS is disabled, code blocks still render and scroll normally.
  */
  const blocks = document.querySelectorAll<HTMLPreElement>('.prose pre');

  blocks.forEach((pre) => {
    // Wrap the <pre> so the absolutely-positioned button anchors to it.
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code to clipboard');

    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        // Fallback for older browsers / insecure contexts.
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          // Deprecated but kept as a fallback for insecure contexts/older
          // browsers where the async Clipboard API is unavailable.
          (document as unknown as { execCommand: (c: string) => boolean })
            .execCommand('copy');
        } catch {
          /* give up silently */
        }
        document.body.removeChild(ta);
      }
      btn.textContent = 'Copied';
      btn.dataset.copied = 'true';
      window.setTimeout(() => {
        btn.textContent = 'Copy';
        btn.removeAttribute('data-copied');
      }, 1600);
    });

    wrapper.appendChild(btn);
  });
</script>
