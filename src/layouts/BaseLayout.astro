---
/**
 * BaseLayout — the single HTML document shell for every page.
 *
 * Responsibilities (so pages never duplicate them):
 *   - <html>/<head>/<body> structure and lang
 *   - core + SEO meta (title, description, canonical, Open Graph, Twitter)
 *   - per-page og:type (website | article) + article published/modified times
 *   - sitewide WebSite JSON-LD, plus any page-specific JSON-LD passed via props
 *   - global stylesheet import
 *   - no-flash theme script (must run before paint)
 *   - skip-to-content link, Header, <main>, Footer
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import SearchModal from '../components/SearchModal.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE } from '../utils/site';

type JsonLdSchema = Record<string, unknown>;

interface Props {
  /** Page-specific title. Combined with the site name. */
  title?: string;
  /** Page-specific meta description. Falls back to the site description. */
  description?: string;
  /** Absolute or root-relative OG image path. */
  image?: string;
  /** Set true on pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Open Graph object type. Articles set this to 'article'. */
  ogType?: 'website' | 'article';
  /** ISO date the article was published (article pages only). */
  publishedTime?: string;
  /** ISO date the article was last modified (article pages only). */
  modifiedTime?: string;
  /** Page-specific JSON-LD block(s), e.g. BlogPosting, Person, BreadcrumbList. */
  jsonLd?: JsonLdSchema | JsonLdSchema[];
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;

// Canonical + absolute OG URL derived from the configured production `site`.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url);

/**
 * Per-page Open Graph image.
 *
 * Every page/post gets a build-time generated image (see src/pages/og/) whose
 * filename matches its route, so social previews are page-specific instead of
 * one shared default. The mapping mirrors the `pages` map in the OG endpoint:
 *   /                 → /og/home.png
 *   /blog             → /og/blog.png
 *   /blog/<slug>      → /og/blog/<slug>.png
 *   /projects/<slug>  → /og/projects/<slug>.png
 * An explicit `image` prop still overrides (e.g. a curated share image); the
 * static SITE.ogImage remains the ultimate fallback for unmapped routes.
 */
function ogRouteForPath(pathname: string): string {
  const clean = pathname.replace(/^\/+|\/+$/g, ''); // trim slashes
  if (clean === '') return 'og/home.png';
  return `og/${clean}.png`;
}

const resolvedOgImage = image ?? `/${ogRouteForPath(Astro.url.pathname)}`;
const ogImageURL = new URL(resolvedOgImage, Astro.site ?? SITE.url);

// Sitewide WebSite structured data (present on every page).
const websiteSchema: JsonLdSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
};

// Normalize page JSON-LD to an array so we can render one block per schema.
const pageSchemas: JsonLdSchema[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {ogType === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime} />
    )}

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- RSS autodiscovery. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Blog`}
      href={new URL('/rss.xml', Astro.site ?? SITE.url)}
    />

    <!-- Structured data: sitewide WebSite + any page-specific schemas. -->
    <JsonLd schema={websiteSchema} />
    {pageSchemas.map((s) => <JsonLd schema={s} />)}

    <!-- No-flash theme init: must be before first paint. -->
    <ThemeScript />
  </head>
  <body>
    <ScrollProgress />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
