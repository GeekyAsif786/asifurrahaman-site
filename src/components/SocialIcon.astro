---
/**
 * SocialIcon — inline SVG glyphs for social links.
 *
 * Lightweight, dependency-free (five hand-inlined paths) so we don't pull in a
 * whole icon library for five icons. Icons are decorative (aria-hidden); the
 * link itself carries the accessible label.
 */
import type { SocialIconName } from '../utils/site';

interface Props {
  name: SocialIconName;
  size?: number;
}

const { name, size = 18 } = Astro.props as Props;
---

