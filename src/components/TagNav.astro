---
/**
 * TagNav — horizontal row of tag "pills" shown above the blog post list.
 *
 * - Always renders an "All Posts" pill (links to /blog) that is active when no
 *   tag is selected.
 * - Renders one pill per unique tag as "name (count)", linking to /tags/[slug].
 * - `tags` is expected pre-sorted (count desc, then alphabetical) by the
 *   caller via collectTags(); a tag with a zero count never appears because
 *   collectTags only includes tags that occur on at least one post.
 * - The pill matching `activeSlug` is visually marked and carries
 *   aria-current="page".
 *
 * Reuses the site's existing pill visual language (mono chip, subtle glass
 * border, accent-soft hover) and design tokens — no new styling system.
 */
import type { TagCount } from '../utils/tags';

interface Props {
  tags: TagCount[];
  /** The active tag slug, or null/undefined on the unfiltered /blog view. */
  activeSlug?: string | null;
}

const { tags, activeSlug = null } = Astro.props as Props;
const allActive = !activeSlug;
---

<nav class="tag-nav" aria-label="Filter posts by tag">
  <ul>
    <li>
      <a
        href="/blog"
        class:list={['pill', { active: allActive }]}
        aria-current={allActive ? 'page' : undefined}
      >
        All Posts
      </a>
    </li>
    {
      tags.map((t) => {
        const isActive = t.slug === activeSlug;
        return (
          <li>
            <a
              href={`/tags/${t.slug}`}
              class:list={['pill', { active: isActive }]}
              aria-current={isActive ? 'page' : undefined}
            >
              {t.tag}
              <span class="count">({t.count})</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<style>
  .tag-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .pill {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.82rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text);
    background:
      linear-gradient(var(--glass-bg-strong), var(--glass-bg-strong)) padding-box,
      linear-gradient(
        135deg,
        var(--glass-border-line),
        color-mix(in oklab, var(--color-accent) 42%, transparent)
      ) border-box;
    border: var(--border-width) solid var(--glass-border-line);
    border-radius: 999px;
    box-shadow: 0 1px 2px rgba(20, 22, 27, 0.04);
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease,
      box-shadow 0.18s ease, transform 0.18s ease;
  }
  .pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      135deg,
      var(--color-accent-soft),
      color-mix(in oklab, var(--color-accent) 16%, transparent)
    );
    opacity: 0;
    transform: scaleX(0.45);
    transform-origin: left;
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    box-shadow: 0 8px 22px rgba(20, 22, 27, 0.08);
    transform: translateY(-2px);
  }
  .pill:hover::before {
    opacity: 1;
    transform: scaleX(1);
  }
  .pill.active {
    color: var(--color-accent-contrast);
    background: linear-gradient(
      135deg,
      var(--color-accent),
      color-mix(in oklab, var(--color-accent) 72%, var(--color-text))
    );
    border-color: var(--color-accent);
    box-shadow: 0 10px 28px color-mix(in oklab, var(--color-accent) 22%, transparent);
    transform: translateY(-1px);
  }
  .pill.active::before {
    opacity: 0;
  }
  .count {
    display: inline-flex;
    min-width: 1.35rem;
    justify-content: center;
    padding-inline: 0.35rem;
    border-radius: 999px;
    background: color-mix(in oklab, currentColor 9%, transparent);
    opacity: 0.8;
  }
  .pill.active .count {
    background: color-mix(in oklab, var(--color-accent-contrast) 18%, transparent);
    opacity: 0.9;
  }
</style>
