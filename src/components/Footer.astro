---
/**
 * Footer — the closing section of the site.
 *
 * Multi-column on desktop (Identity · Quick Links · Resources · Connect),
 * stacked on mobile. Social links come from the single config source
 * (getSocials() in utils/site.ts); each is rendered with a recognizable icon
 * and an accessible label. Email links use mailto: and open in the same tab.
 *
 * The footer uses a subtle glass surface consistent with the rest of the site.
 */
import Container from './Container.astro';
import SocialIcon from './SocialIcon.astro';
import { SITE, NAV, getSocials } from '../utils/site';

const year = new Date().getFullYear();
const socials = getSocials();
---

<footer class="site-footer">
  <Container>
    <div class="grid">
      {/* Identity */}
      <div class="identity">
        <a href="/" class="brand">{SITE.name}</a>
        <p class="blurb">
          Engineering projects, technical writing, and learning notes.
        </p>
      </div>

      {/* Quick Links */}
      <nav class="col" aria-label="Footer navigation">
        <h2 class="col-title">Quick Links</h2>
        <ul>
          {NAV.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      {/* Resources */}
      <nav class="col" aria-label="Resources">
        <h2 class="col-title">Resources</h2>
        <ul>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="/sitemap-index.xml">Sitemap</a></li>
        </ul>
      </nav>

      {/* Connect */}
      <div class="col">
        <h2 class="col-title">Let’s Connect</h2>
        {
          socials.length > 0 ? (
            <ul class="socials">
              {socials.map((s) => (
                <li>
                  <a
                    class="social-link"
                    href={s.href}
                    aria-label={s.label}
                    {...(s.sameTab
                      ? {}
                      : { target: '_blank', rel: 'me noopener' })}
                  >
                    {s.icon && <SocialIcon name={s.icon} />}
                    <span class="social-text">{s.label}</span>
                    {!s.sameTab && (
                      <span class="visually-hidden"> (opens in a new tab)</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">Social links coming soon.</p>
          )
        }
      </div>
    </div>

    <div class="baseline">
      <p class="copy">© {year} {SITE.name}</p>
      <p class="built">Backend Developer · ML Engineer</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    border-top: var(--border-width) solid var(--glass-border-line);
    background: var(--glass-bg);
    padding-block: var(--space-16) var(--space-8);
    font-size: var(--text-sm);
  }
  @supports (backdrop-filter: blur(1px)) or
    (-webkit-backdrop-filter: blur(1px)) {
    .site-footer {
      -webkit-backdrop-filter: blur(var(--glass-blur));
      backdrop-filter: blur(var(--glass-blur));
    }
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .identity .brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    font-synthesis: none;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }
  .identity .brand:hover {
    color: var(--color-accent);
  }
  .blurb {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    max-width: 22rem;
  }

  .col-title {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .col a {
    color: var(--color-text);
    text-decoration: none;
  }
  .col a:hover {
    color: var(--color-accent);
  }

  /* Social links: icon + label, subtle hover. */
  .socials .social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
  }
  .socials .social-link:hover {
    color: var(--color-accent);
    transform: translateX(2px);
  }
  .empty {
    color: var(--color-text-muted);
  }

  .baseline {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--glass-border-line);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }
  .baseline p {
    margin: 0;
  }

  /* Tablet: two columns. */
  @media (min-width: 560px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .identity {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: identity + three link columns. */
  @media (min-width: 860px) {
    .grid {
      grid-template-columns: 2fr 1fr 1fr 1.2fr;
      gap: var(--space-12);
    }
    .identity {
      grid-column: auto;
    }
    .baseline {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
