---
/**
 * Container — centers content and applies a max width + horizontal padding.
 *
 * variant:
 *   'default' → wide content (68rem)
 *   'prose'   → narrow, reading-optimized width (44rem) for articles
 *
 * `as` lets the caller pick the semantic element (section, main, div, ...).
 */
interface Props {
  variant?: 'default' | 'prose';
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const {
  variant = 'default',
  as = 'div',
  class: className = '',
} = Astro.props as Props;
const Tag = as;
---

<Tag class:list={['container', `container--${variant}`, className]}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .container--default {
    max-width: var(--container-max);
  }
  .container--prose {
    max-width: var(--container-prose);
  }
  @media (min-width: 640px) {
    .container {
      padding-inline: var(--space-6);
    }
  }
</style>
