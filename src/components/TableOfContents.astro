---
/**
 * TableOfContents — builds an in-page nav from a post's headings.
 *
 * `headings` is the array returned by Astro's render() ({ depth, slug, text }).
 * We show h2 and h3 only (depth 2–3) to keep the TOC shallow and useful. The
 * article page decides whether to render this at all (e.g. only for longer
 * articles with enough headings).
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p id="toc-title" class="toc-title">On this page</p>
      <ul>
        {items.map((h) => (
          <li class:list={[`depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc {
    font-size: var(--text-sm);
  }
  .toc-title {
    margin: 0 0 var(--space-2);
    font-weight: 650;
    color: var(--color-text);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .toc a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--color-accent);
  }
  .toc .depth-3 {
    padding-left: var(--space-4);
  }
</style>
